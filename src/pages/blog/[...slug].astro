---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;
---

<Layout title={`${title} | matheus teixeira`} description={description}>
    <article
        class:list={[
            'scroll-smooth',
            'prose',
            'prose-headings:text-text prose-headings:text-justify',
            'prose-h1:text-3xl prose-h1:mb-0!',
            'prose-h2:text-2xl prose-h2:mt-0!',
            'prose-img:m-0!',
            'prose-p:text-text prose-p:text-justify',
            'prose-headings:font-bricolage-grotesque',
            'prose-p:font-cossette-texte',
            'prose-a:text-mauve',
            'hover:prose-a:text-mauve',
            'prose-table:text-text',
            'prose-li:text-text',
        ]}
    >
        <header class='mb-8 not-prose'>
            <a
                href='/blog'
                class='text-xs flex items-center mb-10 w-fit text-text group'
            >
                <Icon icon='arrow_back' class='text-[16px]!' />{' '}
                <span class='group-hover:underline'>go back</span>
            </a>

            <h1 class='text-3xl font-bold font-bricolage-grotesque text-text'>
                {title}
            </h1>

            {description && (
                <p class='text-text/50 font-cossette-texte mt-2 italic'>
                    {description}
                </p>
            )}

            <div class='flex items-center gap-2 mt-2 text-xs text-text/30 font-mono'>
                <time datetime={date}>{date}</time>
            </div>
        </header>

        <Content />
    </article>
</Layout>
